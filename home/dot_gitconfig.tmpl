# =============================================================================
# Git Configuration (~/.gitconfig)
# Managed by Chezmoi - Apple Silicon (M4 Pro) + Delta + GPG Signing
# =============================================================================

[user]
  name = {{ .name }}
  email = {{ .email }}
  signingkey = {{ .signingkey }}

[init]
  defaultBranch = main

[core]
  pager = delta
  whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
  editor = vim
  excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  side-by-side = false
  line-numbers = true
  syntax-theme = Solarized (dark)

[credential]
  helper = osxkeychain

[color]
  ui = true

[push]
  default = current
  autoSetupRemote = true

[pull]
  rebase = true

[rebase]
  autostash = true
  autoSquash = true

[fetch]
  prune = true
  pruneTags = true

[diff]
  colorMoved = default
  algorithm = histogram
  indentHeuristic = true

[merge]
  conflictstyle = zdiff3

[submodule]
  fetchJobs = 8

[status]
  submoduleSummary = true

[commit]
  gpgsign = true

[gpg]
  # Dynamically resolves to /opt/homebrew/bin/gpg on M4 Pro or /usr/local/bin/gpg
  program = {{ if stat "/opt/homebrew/bin/gpg" }}/opt/homebrew/bin/gpg{{ else }}/usr/local/bin/gpg{{ end }}

[alias]
  aliases = !git config --get-regexp 'alias.*' | colrm 1 6 | sed 's/[ ]/ = /'
  a = add
  aa = add .
  ai = add -i
  b = branch
  c = commit
  cm = commit -m
  cs = commit -S
  cms = commit -S -m
  co = checkout
  cob = checkout -b
  sw = switch
  swc = switch -c
  ci = commit
  clean = clean -f -d
  clone = clone --recursive --recurse-submodules
  d = diff
  desc = describe
  diff = diff --submodule=diff HEAD
  f = fetch --prune --all
  h = "!f(){ git log --tags --simplify-by-decoration --pretty='format:%ci %d' | sort -r; }; f"
  log = log --show-signature
  m = merge
  mf = merge --no-ff
  o = "!f(){ git remote -v | awk '/fetch/{print $2}' | sed -Ee 's#(ssh://git@|git://)#https://#' | sed -Ee 's@com:@com/@' | head -n1 | xargs open; }; f"
  p = push
  pf = push --force-with-lease
  pl = "!f(){ git up \"$@\" && git submodule update --init --recursive; }; f"
  pull = up
  s = "!~/.local/bin/git-status"
  su = submodule update --recursive --init
  ss = submodule sync
  stl = stash list --pretty=format:'%Cblue%h %Cred* %C(yellow)%s'
  sts = stash push
  sta = stash apply
  std = stash drop
  up = "!git remote update -p; git merge --ff-only @{u}"
  who = shortlog -s --
  lv = describe --always --dirty
  v = describe --always --dirty
  l = "!git --no-pager log -1 --format=format:\"$path: (%G?) %Cgreen%s%Creset (%Cred$(git rev-parse --abbrev-ref HEAD)%Creset/%ar)\"; echo "
  remote-branch = "!echo $(git config branch.$(git rev-parse --abbrev-ref HEAD).remote)/$(git config branch.$(git rev-parse --abbrev-ref HEAD).merge | cut -d '/' -f 3-)"
  out = "!git --no-pager log $(git remote-branch)..HEAD --format=format:'%Cgreen%h%Creset %Cred%d%Creset %s %Cblue(%ar by %an)%Creset'; echo ''"
  in = "!git --no-pager log HEAD..$(git remote-branch) --format=format:'%Cgreen%h%Creset %Cred%d%Creset %s %Cblue(%ar by %an)%Creset'"
  lg = "log --color --graph --pretty=format:'%Cred%h%Creset (%G?) - %C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
  ignore = "!gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ ;}; gi"
  ui = !lazygit
