# =============================================================================
# SSH Configuration (~/.ssh/config)
# Managed by Chezmoi - macOS Keychain & OrbStack Support
# =============================================================================

# Include local or tool-managed SSH configs (e.g., OrbStack)
Include ~/.orbstack/ssh/config
Include ~/.ssh/config.local

Host *
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
