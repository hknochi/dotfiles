# =============================================================================
# Environment Variables & Exports (~/.config/zsh/exports.zsh)
# =============================================================================

# User & Git Identity (Templated via Chezmoi)
export USER_FULLNAME={{ .name | quote }}
export USER_EMAIL={{ .email | quote }}
export MAIL_ADDRESSES="hknochi@gmail.com hknochi@users.noreply.github.com"

# Default Editors (Modern setup: Cursor / VS Code / Zed / Sublime fallback)
if command -v cursor &>/dev/null; then
  export VISUAL="cursor --wait"
elif command -v code &>/dev/null; then
  export VISUAL="code --wait"
elif command -v zed &>/dev/null; then
  export VISUAL="zed --wait"
elif command -v subl &>/dev/null; then
  export VISUAL="subl -w"
else
  export VISUAL="vim"
fi
export EDITOR="vim"

# Locale
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Homebrew behaviour
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_ENV_HINTS=1

# Bat (cat replacement) theme
export BAT_THEME="Solarized (dark)"

# fzf default options (use fd if installed for fast file discovery respecting .gitignore)
if command -v fd &>/dev/null; then
  export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git"
  export FZF_CTRL_T_COMMAND="${FZF_DEFAULT_COMMAND}"
  export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git"
fi

# GPG TTY (required for pinentry in terminal)
export GPG_TTY=$(tty)

# Java Home (only if a JDK is actually installed on this Mac)
if /usr/libexec/java_home &>/dev/null; then
  export JAVA_HOME="$(/usr/libexec/java_home)"
fi
