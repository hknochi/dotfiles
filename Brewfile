# =============================================================================
# Homebrew Bundle (Brewfile) - Apple Silicon (M4 Pro) Setup
# =============================================================================

# Taps
tap "homebrew/bundle"

# -----------------------------------------------------------------------------
# Core & Shell
# -----------------------------------------------------------------------------
brew "coreutils"
brew "curl"
brew "wget"
brew "git"
brew "git-lfs"
brew "git-delta"           # Modern syntax-highlighting pager for git
brew "gnupg"
brew "pinentry-mac"        # Native macOS keychain integration for GPG
brew "powerlevel10k"       # Fast Zsh theme (successor to powerlevel9k)
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-completions"

# -----------------------------------------------------------------------------
# Modern CLI Replacements & Developer Tools
# -----------------------------------------------------------------------------
brew "eza"                 # Modern replacement for 'ls' (written in Rust)
brew "bat"                 # Modern replacement for 'cat' with syntax highlighting
brew "ripgrep"             # Modern replacement for 'grep' / 'ack' (rg)
brew "fd"                  # Modern replacement for 'find'
brew "fzf"                 # Command-line fuzzy finder
brew "zoxide"              # Smarter 'cd' command (replaces fasd/z)
brew "btop"                # Resource monitor (modern top/htop)
brew "ncdu"                # Fast disk usage analyzer
brew "jq"                  # Lightweight and flexible command-line JSON processor
brew "yq"                  # YAML/XML/TOML processor
brew "lazygit"             # Simple terminal UI for git commands
brew "gh"                  # GitHub CLI
brew "tlrc"                # Fast tldr client (community-driven man pages)
brew "tree"
brew "pwgen"
brew "watch"
brew "direnv"              # Unclutter your .profile & loadproject env vars
brew "fnm"                 # Fast Node Manager (modern Rust replacement for nvm)
brew "uv"                  # Extremely fast Python package and project manager

# -----------------------------------------------------------------------------
# Applications & Casks (Apple Silicon Native)
# -----------------------------------------------------------------------------
# Terminal & Shell
cask "iterm2"
cask "font-meslo-lg-nerd-font"      # Recommended font for Powerlevel10k
cask "font-jetbrains-mono-nerd-font"
cask "font-source-code-pro"

# Containers & Virtualization
cask "orbstack"                     # Fast, light, native Docker & Linux on macOS

# Editors & IDEs
cask "visual-studio-code"
cask "cursor"
cask "zed"
cask "sublime-text"                 # Sublime Text 4
cask "marked-2"                     # Markdown previewer

# Security & Passwords
cask "enpass"                       # Enpass Password Manager
cask "gpg-suite-no-mail"

# Productivity
cask "raycast"                      # Modern launcher & window manager (replaces Slate/Spotlight)
